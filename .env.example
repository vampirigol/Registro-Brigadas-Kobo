# URL del formulario Enketo de KoboToolbox
FORM_URL=https://ee-eu.kobotoolbox.org/x/5htUNnQd

# Ruta al archivo Excel con los datos
EXCEL_PATH=datos.xlsx

# Ir directo a la URL del formulario (más fiable; true por defecto)
USE_DIRECT_FORM_URL=true

# Ejecutar navegador en segundo plano (true) o visible (false)
HEADLESS=false

# Fila desde la cual reanudar (0 = desde el inicio, dejar vacío para iniciar desde el principio)
RESUME_FROM_ROW=

# === Envío por API (recomendado: evita el navegador y el llenado automático del formulario) ===
# Si defines KOBO_API_TOKEN y KOBO_ASSET_UID, la carga usará la API y no abrirá el navegador.
# Cómo obtenerlos:
#   1. Token: KoboToolbox → Cuenta → API Token (crear/copiar).
#   2. Asset UID: En tu formulario en https://kf.kobotoolbox.org/ → el UID del asset (o en la URL del formulario).
# Servidor EU: usa KOBO_KC_URL=https://kc-eu.kobotoolbox.org si tu formulario está en ee-eu.
# KOBO_API_TOKEN=
# KOBO_ASSET_UID=
# KOBO_KC_URL=https://kc.kobotoolbox.org
